# Set default behavior to automatically normalize line endings
* text=auto

# Force specific line endings for different file types
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.pyc binary
*.db binary
*.sqlite3 binary

# Django specific
*.py text eol=lf
manage.py text eol=lf
requirements.txt text eol=lf 