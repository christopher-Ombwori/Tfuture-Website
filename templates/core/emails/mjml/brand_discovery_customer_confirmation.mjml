<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Segoe UI, Tahoma, sans-serif" color="#1f2937" />
      <mj-text font-size="15px" line-height="1.7" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#1d2840" padding="18px 20px 18px 20px">
      <mj-column>
        <mj-image src="https://www.tfuturedesigns.studio/static/images/email_images/tfuture%20logo%20teal.png" alt="TFuture logo " align="center" width="240px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#f3f4f6" padding="0">
      <mj-column padding="0">
        <mj-text padding="0">
          <div style="background-color:#ffffff;padding:26px 26px 12px 26px;">
            <div style="text-align:center;margin-bottom:18px;"><img src="https://www.tfuturedesigns.studio/static/images/email_images/success%20confirmation.png" alt="Success icon" width="96" style="display:block;margin:0 auto;" /></div>
            <p style="margin:0 0 14px 0;color:#1f2937;font-size:15px;">Hello {{ rep_name }},</p>
            <p style="margin:0 0 14px 0;color:#1f2937;font-size:15px;">Thank you for completing the brand discovery form. We've successfully received your inputs for <strong style="font-weight:600;">{{ business_name }}</strong>.</p>
            <p style="margin:0 0 10px 0;color:#1f2937;font-size:15px;">Our team is now aligning your priorities with the proposed deliverables. Within 24–48 hours, we'll share a clear plan including:</p>
            <ul style="margin:0 0 20px 0;padding-left:20px;color:#1f2937;font-size:15px;">
              <li style="margin:10px 0;line-height:1.5;">Suggested next steps</li>
              <li style="margin:10px 0;line-height:1.5;">Proposed timeline</li>
              <li style="margin:10px 0;line-height:1.5;">Upcoming collaboration milestone</li>
            </ul>
            <p style="margin:0 0 14px 0;color:#1f2937;font-size:15px;">We're excited to move forward and bring your vision to life.</p>
            <div style="background-color:#e0f2f1;padding:15px;border-radius:6px;color:#0f766e;font-size:14px;line-height:1.6;margin:0;">Prefer a quick reply? Just hit reply to this email or email contact@tfuturedesigns.studio and we'll include it in our review.</div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#1d2840" padding="18px 25px 14px 25px">
  <mj-column>

    <!-- Footer Logo -->
    <mj-image
      src="https://www.tfuturedesigns.studio/static/images/email_images/tfuture%20logo%20white-02.png"
      alt="TFuture Designs"
      align="center"
      width="90px"
      padding="0 0 2px 0"
    />

    <!-- Tagline -->
    <mj-text
      align="center"
      color="#9CA3AF"
      font-size="12px"
      line-height="1.2"
      padding="0 0 10px 0"
    >
      Envision it, we make it happen
    </mj-text>

    <!-- Social Icons -->
    <mj-text align="center" padding="0 5px 10px 0" line-height="0">
      <a href="https://www.linkedin.com/company/tfuture-designs/" target="_blank">
        <img src="https://www.tfuturedesigns.studio/static/images/email_images/linkedin-icon.png" width="22" style="display:inline-block;border:0;" />
      </a>
      <a href="https://www.instagram.com/tfuturedesigns/" target="_blank">
        <img src="https://www.tfuturedesigns.studio/static/images/email_images/instagram-icon.png" width="22" style="display:inline-block;border:0;" />
      </a>
      <a href="https://www.facebook.com/profile.php?id=61574848637945" target="_blank">
        <img src="https://www.tfuturedesigns.studio/static/images/email_images/facebook-icon.png" width="22" style="display:inline-block;border:0;" />
      </a>
      <a href="https://www.tiktok.com/@tfuturedesigns/" target="_blank">
        <img src="https://www.tfuturedesigns.studio/static/images/email_images/tiktok-icon.png" width="22" style="display:inline-block;border:0;" />
      </a>
    </mj-text>

    <!-- Disclaimer -->
    <mj-text
      align="center"
      color="#9CA3AF"
      font-size="11px"
      padding="0"
      line-height="1.3"
    >
      Please note: This is an automated confirmation email.
    </mj-text>

  </mj-column>
</mj-section>
